FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /o11y-workbench-web ./cmd/o11y-workbench-web/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /o11y-workbench-web /o11y-workbench-web
EXPOSE 8080
ENTRYPOINT ["/o11y-workbench-web"]
CMD ["--addr", ":8080"]
