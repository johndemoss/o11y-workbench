# Dual-train OTTL pins for o11y-workbench.
# - DEFAULT matches the in-process go.mod collector train.
# - WORKER_VERSIONS are extra trains built from workers/ottl-<ver> into bin/ottl-worker-<ver>.
# serve.sh sources this file and exports O11Y_OTTL_WORKERS unless already set.
OTEL_COLLECTOR_CONTRIB_VERSION=0.151.0
OTEL_COLLECTOR_STABLE_VERSION=1.57.0
OTEL_OTTL_DEFAULT_VERSION=0.151.0
OTEL_OTTL_WORKER_VERSIONS=0.162.0
