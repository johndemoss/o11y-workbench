# Dockerfile for o11y-workbench CLI (demo sender)
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /o11y-workbench ./cmd/o11y-workbench/

FROM alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab
RUN apk add --no-cache ca-certificates \
	&& adduser -D -u 65532 -H -s /sbin/nologin nonroot
COPY --from=builder /o11y-workbench /usr/local/bin/o11y-workbench
ENV HOME=/tmp
USER nonroot

# No ports exposed - this is a client that sends data to collectors
ENTRYPOINT ["/usr/local/bin/o11y-workbench"]
# Default command can be overridden in docker-compose
CMD ["--help"]
