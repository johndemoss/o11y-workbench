# Graphify 0.9.108+ merges .gitignore with these project-specific rules.
# Explicit exclusions here also apply to tracked files that Graphify otherwise
# exempts from .gitignore (for example old embedded bundles).

# Build artifacts
/o11y-workbench
/o11y-workbench-web
bin/

# Credentials and private local/session state must never enter the graph.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.cursor/
.remember/
.od-skills/
tmp/

# Session/planning artifacts
.sisyphus/
graphify-out/

# Node.js
node_modules/
package.json
package-lock.json

# Playwright test artifacts
test-results/
playwright-report/
traces/

# Svelte pipeline UI build output
pipeline-ui/dist/
internal/server/pipeline-ui/dist/
.playwright-mcp/

# Playwright cache
pipeline-ui/playwright/.cache/
screenshots/

# FAC-04: exclude test files from the knowledge graph.
# Test scaffolding (Go testing.T, TestXxx funcs, vitest/playwright specs)
# appears mechanically across every package, creating cross-community bridge
# nodes that inflate betweenness and generate noise-only suggested questions.
*_test.go
*.test.ts
*.test.js
*.spec.ts
*.spec.js
**/__tests__/
pipeline-ui/e2e/
tests/
